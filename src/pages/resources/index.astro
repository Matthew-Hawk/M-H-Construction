---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptImage from '../../components/ConceptImage.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Arrow from '../../components/Arrow.astro';
import { articles } from '../../data/journal';
import { services } from '../../data/site';
const featured = articles[0];
const categories = ['All Guides', 'Kitchen Planning', 'Bathroom Planning', 'Getting Started'];
---
<BaseLayout title="The Remodeling Journal — Kitchen & Bathroom Guides" description="Practical guides to planning a kitchen or bathroom remodel, making scope decisions, and preparing for construction in Bryan–College Station.">
  <section class="container page-intro journal-heading"><p class="eyebrow">THE REMODELING JOURNAL</p><h1>Plan your remodel.<br /><em>With a little more clarity.</em></h1><p class="intro-text">Practical kitchen and bathroom guides to help you explore ideas and prepare for your first conversation.</p><p class="editorial-note">Preview articles prepared for M&amp;H review before publication.</p><div class="journal-discovery"><div class="journal-filters" role="group" aria-label="Filter homeowner guides">{categories.map((category, index) => <button type="button" data-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>)}</div><p id="guide-count" class="guide-count" role="status" aria-live="polite">{articles.length} guides</p></div></section>
  <section class="container journal-feature"><ConceptImage src={services[0].image} alt={services[0].alt} /><div class="journal-feature-copy"><p class="eyebrow">START HERE · {featured.minutes} MIN READ</p><h2><a href={`/resources/${featured.slug}/`}>{featured.frontmatter.title}</a></h2><p>{featured.frontmatter.description}</p><a class="button" href={`/resources/${featured.slug}/`}>Read the Guide <Arrow /></a></div></section>
  <section class="section container journal-library"><div class="section-heading"><div><p class="eyebrow">MAKE YOURSELF AT HOME</p><h2>Explore the Planning Guides.</h2></div></div><div class="resource-grid">{articles.map(article => <ArticleCard article={article} />)}</div></section>
  <ContactCTA />
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.resource-card[data-category]');
    const count = document.querySelector('#guide-count');
    buttons.forEach(button => button.addEventListener('click', () => {
      buttons.forEach(other => other.setAttribute('aria-pressed', String(other === button)));
      let visible = 0;
      cards.forEach(card => { card.hidden = button.dataset.filter !== 'All Guides' && card.dataset.category !== button.dataset.filter; if (!card.hidden) visible++; });
      if (count) count.textContent = `${visible} ${visible === 1 ? 'guide' : 'guides'}${button.dataset.filter === 'All Guides' ? '' : ` · ${button.dataset.filter}`}`;
    }));
  </script>
</BaseLayout>
