---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { business } from '../data/site';
---
<BaseLayout title="Discuss Your Kitchen or Bathroom Project" description="Call M&H Construction at 979-739-7486 or email Matthew@mandhconstructionbcs.com to discuss your kitchen or bathroom remodel.">
  <section class="container page-intro contact-intro"><p class="eyebrow">LET’S TALK ABOUT YOUR HOME</p><h1>Discuss your<br /><em>remodeling project.</em></h1><p class="intro-text">A finished plan, a few saved photos, or just a question. Tell us what you have in mind.</p></section>
  <section class="container contact-grid">
    <aside><p class="eyebrow">CONTACT MATTHEW DIRECTLY</p><a class="contact-phone" href={business.phoneHref}>{business.phone}</a><a class="contact-email" href={business.emailHref}>{business.email}</a><p class="contact-service-area">Serving Bryan, College Station, and Brazos County. Farther projects considered by scope.</p><p class="contact-note">Replies by phone or email.</p></aside>
    <form id="project-form" novalidate><h2>Tell us about your project.</h2><p class="form-intro" id="form-method">This preview prepares an email in your email app. Nothing is sent or saved by this website. You’ll review and send the email yourself.</p>
      <h3 class="form-section-title">Your project</h3>
      <label>Your name <span>(required)</span><input name="name" autocomplete="name" required maxlength="100" /></label>
      <fieldset class="project-type"><legend>Project type <span>(required)</span></legend><div class="project-type-options">{['Kitchen', 'Bathroom', 'Both'].map(service => <label><input type="radio" name="service" value={service} required /><span>{service}</span></label>)}</div></fieldset>
      <div class="form-row"><label>Email<input name="email" type="email" autocomplete="email" maxlength="254" /></label><label>Phone<input name="phone" type="tel" autocomplete="tel" maxlength="40" /></label></div><p class="field-help">Please provide at least one reply method: email or phone.</p>
      <label>What do you have in mind? <span>(required)</span><textarea name="message" rows="4" required maxlength="3000" placeholder="Tell us about your space and what you’d like to change."></textarea></label>
      <details class="planning-details"><summary>Optional planning details</summary><div class="planning-details-content"><p class="field-help">Share what you know. It’s fine to leave these details for our conversation.</p><div class="form-row"><label>City <span>(optional)</span><input name="city" autocomplete="address-level2" maxlength="100" /></label><label>Ideal timing <span>(optional)</span><select name="timeline"><option value="">Choose if you know</option><option>Just exploring</option><option>Next 1–3 months</option><option>3–6 months</option><option>Flexible</option></select></label></div><label>Approximate budget <span>(optional)</span><input name="budget" placeholder="A rough idea, if you have one" maxlength="100" /></label><label class="checkbox-label"><input type="checkbox" name="guidance" /> I’m not sure yet; I’d appreciate budget guidance.</label></div></details>
      <p id="form-status" role="status" aria-live="polite"></p><p class="field-help">Read our <a href="/privacy-policy/">preview privacy information</a>. Please leave sensitive information and exact home addresses out of this first inquiry.</p><button class="button" type="submit">Prepare Email Inquiry <Arrow /></button><noscript><p>Email preparation needs JavaScript. Please use the direct phone or email links.</p></noscript>
    </form>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>('#project-form');
    const status = document.querySelector<HTMLElement>('#form-status');
    const selectedService = new URLSearchParams(window.location.search).get('service');
    if (form && selectedService && ['Kitchen', 'Bathroom', 'Both'].includes(selectedService)) {
      const radio = form.querySelector<HTMLInputElement>(`input[name="service"][value="${selectedService}"]`);
      if (radio) radio.checked = true;
    }
    form?.addEventListener('submit', event => {
      event.preventDefault();
      form.querySelectorAll('[aria-invalid]').forEach(field => { field.removeAttribute('aria-invalid'); field.removeAttribute('aria-describedby'); });
      const data = new FormData(form);
      const value = (key: string) => String(data.get(key) ?? '').trim();
      let invalid: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null = null;
      let message = '';
      for (const key of ['name', 'service', 'message']) {
        const field = key === 'service' ? form.querySelector<HTMLInputElement>('input[name="service"]')! : form.elements.namedItem(key) as HTMLInputElement | HTMLTextAreaElement;
        if (!value(key)) { invalid = field; message = 'Please complete your name, project type, and project description.'; break; }
      }
      const email = form.elements.namedItem('email') as HTMLInputElement;
      const phone = form.elements.namedItem('phone') as HTMLInputElement;
      if (!invalid && !value('email') && !value('phone')) { invalid = email; message = 'Please add an email address or phone number so we can reply.'; }
      if (!invalid && value('email') && !email.validity.valid) { invalid = email; message = 'Please enter a valid email address.'; }
      if (!invalid && value('phone') && value('phone').replace(/\D/g, '').length < 7) { invalid = phone; message = 'Please enter a phone number with at least seven digits.'; }
      if (invalid) { invalid.setAttribute('aria-invalid', 'true'); invalid.setAttribute('aria-describedby', 'form-status'); if (status) status.textContent = message; invalid.focus(); return; }
      const body = [`Name: ${value('name')}`, `Project: ${value('service')}`, `Email: ${value('email') || 'Not provided'}`, `Phone: ${value('phone') || 'Not provided'}`, `City: ${value('city') || 'Not provided'}`, `Timing: ${value('timeline') || 'Not sure yet'}`, `Budget: ${value('budget') || 'Not provided'}`, `Budget guidance: ${data.has('guidance') ? 'Yes' : 'Not requested'}`, '', value('message')].join('\n');
      window.location.href = `mailto:Matthew@mandhconstructionbcs.com?subject=${encodeURIComponent(`M&H ${value('service')} project inquiry`)}&body=${encodeURIComponent(body)}`;
      if (status) status.textContent = 'Your email app should open with a draft. Review and send it there. Nothing has been sent by this website. If it doesn’t open, use the direct email or phone link.';
    });
  </script>
</BaseLayout>
