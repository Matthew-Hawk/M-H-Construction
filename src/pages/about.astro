---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Arrow from '../components/Arrow.astro';
---
<BaseLayout title="About M&H" description="Kitchen and bathroom remodeling with a personal approach in Bryan, College Station, and Brazos County. Get to know M&H Construction.">
  <section class="container page-intro"><p class="eyebrow">M&amp;H CONSTRUCTION</p><h1>Built around your home.<br /><em>And the people in it.</em></h1><p class="intro-text">Kitchen and bathroom remodeling is personal. It begins with your ideas, your everyday routines, and what you want the next chapter of your home to feel like.</p></section>
  <section class="approach-section"><div class="container approach-grid"><div><p class="eyebrow">A PERSONAL APPROACH</p><h2>Start where<br /><em>you are.</em></h2></div><div><p class="large-copy">A complete plan or a first spark of inspiration. Both are welcome.</p><p>M&amp;H Construction focuses on kitchen and bathroom remodeling in Brazos County. We can work with homeowner ideas and existing plans, with design assistance considered according to each project.</p><p>Our primary service area includes Bryan and College Station. Projects farther out are considered based on scope.</p><a class="text-link" href="/contact/">Start a Conversation <Arrow /></a></div></div></section>
  <section class="section container team-section">
    <figure class="team-portrait-placeholder"><img src="/images/brand/logo-navy.svg" width="262" height="44" alt="M&H Construction" /><figcaption><span class="eyebrow">TEAM PORTRAIT</span><span>Real people.<br />A personal introduction.</span><small>Portrait photography to come</small></figcaption></figure>
    <div class="team-introduction"><p class="eyebrow">THE PEOPLE BEHIND M&amp;H</p><h2>A personal connection.<br /><em>From the first conversation.</em></h2><p>Contact Matthew to discuss your kitchen or bathroom, share your ideas, and talk about the next step for your home.</p><p>Our company story and team introduction are being prepared. This portrait space will feature the people behind M&amp;H.</p><a class="text-link" href="/contact/">Talk With Matthew <Arrow /></a></div>
  </section>
  <ContactCTA />
</BaseLayout>
