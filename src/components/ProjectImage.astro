---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; class?: string; eager?: boolean; sizes?: string; }
const { src, alt, class: className = '', eager = false, sizes = '(max-width: 720px) 100vw, 80vw' } = Astro.props;
---
<figure class:list={['portfolio-image', className]}>
  <Image src={src} alt={alt} widths={[480, 800, 1200, 1536]} sizes={sizes} format="webp" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
  <figcaption>M&amp;H Construction · Project portfolio</figcaption>
</figure>
