---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; class?: string; eager?: boolean; }
const { src, alt, class: className = '', eager = false } = Astro.props;
---
<figure class:list={['concept-image', className]}>
  <Image src={src} alt={alt} widths={[480, 800, 1200, 1536]} sizes="(max-width: 720px) 100vw, 80vw" format="webp" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
  <figcaption>AI-generated design placeholder · Not an M&H project</figcaption>
</figure>
