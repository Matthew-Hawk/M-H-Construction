---
import ConceptImage from './ConceptImage.astro';
import Arrow from './Arrow.astro';
import { services } from '../data/site';
interface Props { service: typeof services[number]; compact?: boolean; }
const { service, compact = false } = Astro.props;
const kitchen = service.short === 'Kitchens';
const id = kitchen ? 'kitchen-concept' : 'bathroom-concept';
---
<article id={id} class:list={['project-story', { 'project-story-compact': compact }]}>
  <div class="project-visuals">
    <ConceptImage src={service.image} alt={service.alt} class="project-main-image" />
    <div class="project-details-images">
      <ConceptImage src={service.image} alt={`Cropped AI-generated ${kitchen ? 'kitchen cabinetry' : 'bathroom vanity'} concept detail; not M&H work`} class="project-detail-image detail-left" />
      {!compact && <ConceptImage src={service.image} alt={`Cropped AI-generated ${kitchen ? 'island and materials' : 'shower and materials'} concept detail; not M&H work`} class="project-detail-image detail-right" />}
    </div>
  </div>
  <div class="project-story-copy">
    <p class="eyebrow">{kitchen ? 'KITCHEN' : 'BATHROOM'} DESIGN CONCEPT · PLACEHOLDER</p>
    <h2>{kitchen ? 'A kitchen for gathering.' : 'A calmer everyday routine.'}</h2>
    <p>{kitchen ? 'An illustrative direction pairing warm oak, ivory cabinetry, and a generous island.' : 'An illustrative direction pairing an oak vanity, soft finishes, and a glass shower.'} This is a generated concept, not a completed M&amp;H project.</p>
    <dl class="project-story-facts">
      <div><dt>Concept goal</dt><dd>{kitchen ? 'A welcoming space to cook, gather, and connect.' : 'A comfortable space for the beginning and end of each day.'}</dd></div>
      <div><dt>Design details</dt><dd>{kitchen ? 'Warm wood, layered lighting, and an island as a focal point.' : 'Natural wood, arched mirrors, and a light material palette.'}</dd></div>
    </dl>
    {compact ? <a class="text-link" href="/our-work/#kitchen-concept">Explore the Portfolio Preview <Arrow /></a> : <p class="project-preview-note">Real project stories will include the homeowner’s goals, the scope of work, and finished photographs.</p>}
  </div>
</article>
