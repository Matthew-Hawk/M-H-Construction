---
import ProjectImage from './ProjectImage.astro';
import Arrow from './Arrow.astro';
import { services } from '../data/site';
interface Props { service: typeof services[number]; compact?: boolean; }
const { service, compact = false } = Astro.props;
const kitchen = service.short === 'Kitchens';
const id = kitchen ? 'kitchen-projects' : 'bathroom-projects';
---
<article id={id} class:list={['project-story', { 'project-story-compact': compact }]}>
  <div class="project-visuals">
    <ProjectImage src={service.image} alt={service.alt} class="project-main-image" sizes="(max-width: 720px) 100vw, 50vw" />
    <div class="project-details-images">
      <ProjectImage src={service.photos[0].image} alt={service.photos[0].alt} class="project-detail-image" sizes="(max-width: 720px) 50vw, 25vw" />
      {!compact && <ProjectImage src={service.photos[1].image} alt={service.photos[1].alt} class="project-detail-image" sizes="(max-width: 720px) 50vw, 25vw" />}
    </div>
  </div>
  <div class="project-story-copy">
    <p class="eyebrow">{kitchen ? 'KITCHENS' : 'BATHROOMS'} · SELECTED WORK</p>
    <h2>{kitchen ? 'A kitchen for gathering.' : 'A calmer everyday routine.'}</h2>
    <p>{kitchen ? 'A look at M&H kitchens, from white cabinetry and contrasting countertops to green cabinets, patterned tile, and farmhouse sinks.' : 'A look at M&H bathrooms, from bright tub surrounds and glass showers to wood vanities and pale blue finishes.'}</p>
    <dl class="project-story-facts">
      <div><dt>In the photographs</dt><dd>{kitchen ? 'Cabinetry, countertops, backsplashes, and islands.' : 'A bathtub and shower surround, a wood vanity with a vessel sink, and a glass-enclosed tiled shower.'}</dd></div>
      <div><dt>A closer look</dt><dd>{kitchen ? 'Different spaces, materials, and finishes from our kitchen portfolio.' : 'Different spaces, materials, and finishes from our bathroom portfolio.'}</dd></div>
    </dl>
    {compact && <a class="text-link" href="/our-work/#kitchen-projects">Explore Our Work <Arrow /></a>}
  </div>
</article>
