---
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/journal.css';
import Motion from '../components/Motion.astro';
import Arrow from '../components/Arrow.astro';
import { business } from '../data/site';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const links = [ ['/kitchen-remodeling/', 'Kitchens'], ['/bathroom-remodeling/', 'Bathrooms'], ['/our-work/', 'Our Work'], ['/resources/', 'Journal'], ['/about/', 'About'], ['/contact/', 'Contact'] ];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | M&amp;H Construction</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#000a27" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'animate' in Element.prototype) {
        document.documentElement.classList.add('page-enter-pending');
      }
    </script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="preview-banner">DESIGN PREVIEW <span>·</span> Interior images are generated placeholders</div>
    <header class="site-header">
      <div class="header-inner container">
        <a class="brand" href="/" aria-label="M&H Construction home"><img src="/images/brand/logo-navy.svg" width="262" height="44" alt="M&H Construction" /></a>
        <button class="menu-toggle" type="button" aria-controls="main-navigation" aria-expanded="false"><span>Menu</span><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.5" /></svg></button>
        <nav id="main-navigation" aria-label="Main navigation">
          {links.map(([href, text]) => <a href={href} aria-current={path === href || (href === '/resources/' && path.startsWith(href)) ? 'page' : undefined}>{text}</a>)}
          <a class="button header-cta" href="/contact/">Discuss Your Project <Arrow /></a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div class="footer-brand"><a href="/" aria-label="M&H Construction home"><img src="/images/brand/logo-navy.svg" width="262" height="44" alt="M&H Construction" /></a><p>Kitchen &amp; bathroom remodeling.<br />Built around you.</p></div>
        <div><p class="eyebrow">EXPLORE</p><a href="/kitchen-remodeling/">Kitchens</a><a href="/bathroom-remodeling/">Bathrooms</a><a href="/our-work/">Our Work</a><a href="/about/">About M&amp;H</a></div>
        <div><p class="eyebrow">A PERSONAL APPROACH</p><a href="/our-process/">Our Process</a><a href="/service-areas/">Service Areas</a><a href="/resources/">The Remodeling Journal</a><a href="/contact/">Discuss Your Project</a></div>
        <div class="footer-contact"><p class="eyebrow">LET’S TALK</p><a href={business.phoneHref}>{business.phone}</a><a href={business.emailHref}>{business.email}</a><p>Serving Brazos County.<br />Projects beyond considered by scope.</p></div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getUTCFullYear()} M&amp;H Construction</span><span>Bryan · College Station · Brazos County, Texas</span><a href="/privacy-policy/">Privacy &amp; preview information</a></div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#main-navigation');
      const setOpen = (open: boolean) => {
        toggle?.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('is-open', open);
        if (open && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) nav?.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, easing: 'ease-out' });
      };
      toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
      nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); } });
      window.matchMedia('(min-width: 1001px)').addEventListener('change', () => setOpen(false));
    </script>
    <Motion />
  </body>
</html>
